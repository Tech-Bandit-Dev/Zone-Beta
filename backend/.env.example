# Zone backend environment
PORT=3000

# JWT — replace in production
JWT_SECRET=dev_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS — Flutter app origin(s), comma separated. Use * only in dev.
CORS_ORIGIN=*

# OTP behaviour (mock mode: any 6-digit code is accepted, no email sent)
OTP_MOCK_MODE=true

# Gmail SMTP — used to send the real OTP email when OTP_MOCK_MODE=false.
# GMAIL_USER: the Gmail address sending the OTP emails
# GMAIL_APP_PASSWORD: a 16-char App Password (Google Account > Security >
# 2-Step Verification > App Passwords) — NOT your regular Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Sign-In — Web OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials). See frontend/README.md for full setup.
GOOGLE_CLIENT_ID=
