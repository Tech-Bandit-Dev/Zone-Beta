# Zone backend environment
PORT=3000

# JWT — replace in production
JWT_SECRET=dev_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS — Flutter app origin(s), comma separated. Use * only in dev.
CORS_ORIGIN=*

# OTP behaviour (mock mode: any 6-digit code is accepted)
OTP_MOCK_MODE=true

# Google Sign-In — Web OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials). See frontend/README.md for full setup.
GOOGLE_CLIENT_ID=
